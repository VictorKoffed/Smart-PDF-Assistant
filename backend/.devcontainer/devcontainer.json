{
  "name": "Smart PDF Backend (Python)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8000],
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "cd backend && pip install --upgrade pip && pip install -r requirements.txt && pip install aider-chat",
  "remoteEnv": {
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
  },
  "customizations": {
    "jetbrains": {
      "backend": "PyCharmProfessional",
      "plugins": [
        "Continue:com.github.continuedev.continueintellijextension"
      ]
    }
  }
}
